frappe.ui.form.on("dummy", {
    refresh(frm) {
        frm.add_custom_button("Create Task (Dialog)", () => {

            let dialog = new frappe.ui.Dialog({
                title: "Create Task",
                fields: [
                    {
                        fieldname: "task_subject",
                        label: "Task Subject",
                        fieldtype: "Data",
                        reqd: 1
                    }
                ],
                primary_action_label: "Create Task",
                primary_action(values) {

                    frappe.call({
                        method: "car_parts.api.create_task",
                        args: {
                            task_subject: values.task_subject
                        },
                        callback: function(r) {
                            if (!r.exc) {
                                dialog.hide();

                                frappe.msgprint({
                                    title: "Success",
                                    message: `Task <b>${r.message}</b> created successfully.`,
                                    indicator: "green"
                                });
                            }
                        }
                    });

                }
            });

            dialog.show();

        });
    }
});